# ============================================================
# Konfigurasi Keamanan & Database KRP
# ============================================================
# PENTING: Salin file ini ke .env dan isi semua nilai di bawah.
# JANGAN pernah menggunakan nilai contoh ini di production!

# Hasilkan SECRET_KEY yang kuat dengan perintah ini di terminal:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=GANTI_DENGAN_STRING_ACAK_PANJANG_MINIMAL_32_KARAKTER

DATABASE_URL=sqlite:///./cashflow.db
ENVIRONMENT=production
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Kredensial Akun Bawaan (Hanya digunakan saat pertama kali inisialisasi database kosong)
# Gunakan password yang kuat dan unik — minimal 12 karakter, kombinasi huruf+angka+simbol.
DEFAULT_OWNER_USER=owner
DEFAULT_OWNER_PASS=GANTI_DENGAN_PASSWORD_KUAT_OWNER
DEFAULT_ADMIN_USER=admin
DEFAULT_ADMIN_PASS=GANTI_DENGAN_PASSWORD_KUAT_ADMIN
